# GIRAF MCP Server Environment Variables
# Copy this file to .env and fill in your values

# GitHub Personal Access Token (required for code search, higher rate limits)
# Create at: https://github.com/settings/tokens
# Scopes needed: repo (read access to public repos)
GITHUB_TOKEN=ghp_your_token_here

# Optional: Custom data directory for context.yaml, personas.yaml, domain/
# GIRAF_DATA_DIR=/path/to/data

# Optional: Directory containing PDFs for extraction (use --extract to convert)
# GIRAF_DOCUMENTS_DIR=/path/to/documents

# Optional: Directory containing extracted markdown files for keyword search
# GIRAF_EXTRACTED_DIR=data/extracted

# Optional: HTTP server settings (for --http mode)
# GIRAF_MCP_HOST=0.0.0.0
# GIRAF_MCP_PORT=8000
