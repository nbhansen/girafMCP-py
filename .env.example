# GIRAF MCP Server Environment Variables
# Copy this file to .env and fill in your values

# GitHub Personal Access Token (required for code search, higher rate limits)
# Create at: https://github.com/settings/tokens
# Scopes needed: repo (read access to public repos)
GITHUB_TOKEN=ghp_your_token_here

# Optional: ChromaDB persistence directory
# CHROMA_PERSIST_DIR=./chroma_data

# Optional: Custom data directory for context.yaml, personas.yaml, domain/
# GIRAF_DATA_DIR=/path/to/data

# Optional: Directory containing PDFs for static document search
# Use an absolute path. PDFs will be auto-ingested on server startup.
# See README.md for folder structure and tagging with _meta.yaml
# GIRAF_DOCUMENTS_DIR=/path/to/documents
